<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.EmpMapper">
	
	<select id="selectEmpList" resultType="com.example.demo.model.Emp">
		SELECT E.*, D.*, S.*
		FROM EMP E
		left JOIN DEPT D ON E.DEPTNO = D.DEPTNO
		JOIN SALGRADE S ON E.SAL BETWEEN S.LOSAL AND S.HISAL
		<where> 
		 	<if test="salgrade != null and salgrade != ''">
		 		S.GRADE = #{salgrade}	
			</if>
		</where>
	</select>

	<delete id="deleteEmp" parameterType="hashmap">
		DELETE FROM EMP WHERE EMPNO = #{empNo}
	</delete>
	
	<insert id="insertEmployee" parameterType="hashmap">
		INSERT INTO EMP(EMPNO, ENAME, JOB, SAL) VALUES (
			#{empNo}, #{ename}, #{job}, #{sal}
		)
	</insert>
	
	<select id="selectEmp" parameterType="hashmap" resultType="com.example.demo.model.Emp">
		SELECT * FROM EMP WHERE EMPNO = #{empNo}
	</select>
	
	
	<select id="selectSalGradeList" parameterType="hashmap" resultType="com.example.demo.model.Emp">
		SELECT 
			*
		FROM	
			SALGRADE
	</select>
</mapper>
