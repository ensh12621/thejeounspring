<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ProfessorMapper">

	<select id="selectProfessorList" parameterType="hashmap" resultType="com.example.demo.model.Professor">
		SELECT P.*, D.* 
		FROM PROFESSOR P
		LEFT JOIN DEPARTMENT D ON P.DEPTNO = D.DEPTNO 
	</select>

	<!--int deleteProfessor(HashMap<String, Object> requestMap);-->
	<delete id="deleteProfessor" parameterType="hashmap">
		DELETE FROM PROFESSOR WHERE PROFNO = #{profNo}
	</delete>
	
	<insert id="insertProfessor" parameterType="hashmap">
		INSERT INTO PROFESSOR(PROFNO, NAME, POSITION, PAY, DEPTNO) 
		VALUES (#{profNo}, #{name}, #{position}, #{pay}, #{deptNo});
	</insert>
	
	<select id="selectProfessor" parameterType="hashmap" resultType="com.example.demo.model.Professor">
		SELECT *
		FROM PROFESSOR
		WHERE PROFNO = #{profNo}
	</select>
	
	
	
	
	<!-- DEPARTMENT -->
	<select id="selectDepartmentList" resultType="com.example.demo.model.Professor" parameterType="hashmap">
		SELECT * 
		FROM DEPARTMENT 
		WHERE DNAME LIKE '%학과' 
	</select>
	
</mapper>
